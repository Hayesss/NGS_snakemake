        "workflow/scripts/alignment_qc_plots.R"


# ============================================================================
# Rule: Replicate correlation heatmap
# ============================================================================

rule replicate_correlation:
    input:
        bin_counts = expand("results/alignment/bed/{sample}_bowtie2.fragmentsCount.bin{binLen}.bed", sample=SAMPLES, binLen=BIN_LEN)
    output:
        pdf = "results/qc/replicate_correlation.pdf"
    params:
        samples = SAMPLES
    script:
        "workflow/scripts/replicate_correlation.R"


# ============================================================================
# Rule: Peak QC and FRiP calculation
# ============================================================================

rule peak_qc:
    input:
        peaks_control = expand("results/peakCalling/SEACR/{sample}_seacr_control.peaks.stringent.bed", sample=TARGETS),
        peaks_top = expand("results/peakCalling/SEACR/{sample}_seacr_top0.01.peaks.stringent.bed", sample=TARGETS),
        bams = expand("results/alignment/bam/{sample}_bowtie2.mapped.bam", sample=TARGETS)
    output:
        peak_summary = "results/qc/peak/peak_qc_peak_summary.tsv",
        reproducibility = "results/qc/peak/peak_qc_reproducibility.tsv",
        frip = "results/qc/peak/peak_qc_frip.tsv",
        pdf = "results/qc/peak/peak_qc.pdf"
    params:
        peak_dir = "results/peakCalling/SEACR",
        bam_dir = "results/alignment/bam",
        samples = ",".join(SAMPLES),
        histones = ",".join([SAMPLE_TO_HISTONE[s] for s in SAMPLES]),
        prefix = "results/qc/peak/peak_qc"
    log:
        "logs/peak_qc/peak_qc.log"
    shell:
        """
        mkdir -p $(dirname {output.pdf})
        mkdir -p $(dirname {log})
        Rscript workflow/scripts/peak_qc.R \
            {params.peak_dir} \
            {params.bam_dir} \
            "{params.samples}" \
            "{params.histones}" \
            {params.prefix} \
            > {log} 2>&1
        """
