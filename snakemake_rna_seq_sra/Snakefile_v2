# 质控
rule data_clean_single:
    input:
        f"{OUT_DIR}/{{project}}/00_raw_data/{{sample}}.fq"
    output:
        temp(f"{OUT_DIR}/{{project}}/01_clean_data/{{sample}}.fq")
    wildcard_constraints:
        project="[A-Za-z0-9_]+",
        sample="[A-Za-z0-9]+"
    threads:
        FASTP_THREADS
    log:
        json=f"{OUT_DIR}/{{project}}/log/fastp/{{sample}}.json",
        html=f"{OUT_DIR}/{{project}}/log/fastp/{{sample}}.html",
        logs=f"{OUT_DIR}/{{project}}/log/fastp/{{sample}}_fastp.log"
    conda:
        "environment.yaml"
    shell:
        """
        mkdir -p $(dirname {log.json}) && \
        fastp -w {threads} -i {input} -o {output} \
            -j {log.json} -h {log.html} &> {log.logs}
        """


rule data_clean_pair:
    input:
        r1=f"{OUT_DIR}/{{project}}/00_raw_data/{{sample}}_R1.fq",
        r2=f"{OUT_DIR}/{{project}}/00_raw_data/{{sample}}_R2.fq"
    output:
        r1=temp(f"{OUT_DIR}/{{project}}/01_clean_data/{{sample}}_R1.fq"),
        r2=temp(f"{OUT_DIR}/{{project}}/01_clean_data/{{sample}}_R2.fq")
    wildcard_constraints:
        project="[A-Za-z0-9_]+",
        sample="[A-Za-z0-9]+"
    threads:
        FASTP_THREADS
    log:
        json=f"{OUT_DIR}/{{project}}/log/fastp/{{sample}}.json",
        html=f"{OUT_DIR}/{{project}}/log/fastp/{{sample}}.html",
        logs=f"{OUT_DIR}/{{project}}/log/fastp/{{sample}}_fastp.log"
    conda:
        "environment.yaml"
    shell:
        """
        mkdir -p $(dirname {log.json}) && \
        fastp -w {threads} -i {input.r1} -I {input.r2} -o {output.r1} -O {output.r2} \
            -j {log.json} -h {log.html} &> {log.logs}
        """


def clean_inputs(wildcards):
    if is_paired(wildcards.project, wildcards.sample):
        return [
            os.path.join(OUT_DIR, wildcards.project, "01_clean_data", f"{wildcards.sample}_R1.fq"),
            os.path.join(OUT_DIR, wildcards.project, "01_clean_data", f"{wildcards.sample}_R2.fq"),
        ]
    return [os.path.join(OUT_DIR, wildcards.project, "01_clean_data", f"{wildcards.sample}.fq")]


# 比对并计数
rule align_and_count:
    input:
        clean_inputs
    output:
        bam=temp(f"{OUT_DIR}/{{project}}/02_read_align/{{sample}}_Aligned.sortedByCoord.out.bam"),
        counts=lambda wildcards: count_file(wildcards.project, wildcards.sample)
    wildcard_constraints:
        project="[A-Za-z0-9_]+",
        sample="[A-Za-z0-9]+"
    params:
        index=config["star_index"],
        prefix=lambda wildcards: wildcards.sample,
        GTF=config["gtf"]
    priority:
        40
    threads:
        STAR_THREADS
    resources:
        mem_mb=lambda wildcards, attempt: 10000 if attempt == 1 else 60000 * (attempt - 1)
    benchmark:
        f"{OUT_DIR}/{{project}}/benchmark/STAR/{{sample}}.tsv"
    conda:
        "environment.yaml"
    log:
        f"{OUT_DIR}/{{project}}/log/{{sample}}_Log.final.out"
    shell:
        """
        mkdir -p {OUT_DIR}/{wildcards.project}/log && \
        STAR \
            --genomeDir {params.index} \
            --runThreadN {threads} \
            --readFilesIn {input} \
            --outFileNamePrefix {OUT_DIR}/{wildcards.project}/02_read_align/{params.prefix}_ \
            --outSAMtype BAM SortedByCoordinate \
            --outBAMsortingThreadN 10 \
            --limitBAMsortRAM $(({resources.mem_mb} * 1000000)) \
            --quantMode GeneCounts --sjdbGTFfile {params.GTF} \
            --outTmpKeep None && \
            mv {OUT_DIR}/{wildcards.project}/02_read_align/{params.prefix}_Log.final.out {log}
        """


rule build_bam_index:
    input:
        f"{OUT_DIR}/{{project}}/02_read_align/{{sample}}_Aligned.sortedByCoord.out.bam"
    output:
        temp(f"{OUT_DIR}/{{project}}/02_read_align/{{sample}}_Aligned.sortedByCoord.out.bam.bai")
    wildcard_constraints:
        project="[A-Za-z0-9_]+",
        sample="[A-Za-z0-9]+"
    conda:
        "environment.yaml"
    threads:
        4
    shell:
        "samtools index -@ {threads} {input}"


rule bamtobw:
    input:
        bam=f"{OUT_DIR}/{{project}}/02_read_align/{{sample}}_Aligned.sortedByCoord.out.bam",
        bai=f"{OUT_DIR}/{{project}}/02_read_align/{{sample}}_Aligned.sortedByCoord.out.bam.bai"
    output:
        lambda wildcards: bigwig_file(wildcards.project, wildcards.sample)
    wildcard_constraints:
        project="[A-Za-z0-9_]+",
        sample="[A-Za-z0-9]+"
    params:
        bs=BAMCOV_CFG.get("bin_size", 50),
        gs=BAMCOV_CFG.get("genome_size", 2913022398),
        norm=BAMCOV_CFG.get("normalize_using", "BPM")
    conda:
        "environment.yaml"
    threads:
        10
    shell:
        """
        bamCoverage -p {threads} \
            --binSize {params.bs} \
            --effectiveGenomeSize {params.gs} \
            --normalizeUsing {params.norm} \
            -b {input.bam} -o {output}
        """


def counts_for_project(wildcards):
    return count_files_for_project(wildcards.project)


rule combine_count:
    input:
        counts_for_project
    output:
        lambda wildcards: merged_count_matrix(wildcards.project)
    wildcard_constraints:
        project="[A-Za-z0-9_]+"
    priority:
        35
    run:
        df = pd.read_csv(input[0], header=None, sep="\t", index_col=0)
        df = df.iloc[:, [0]]
        rename_dict = {1: os.path.basename(input[0]).replace("_ReadsPerGene.out.tab", "")}
        df = df.rename(columns=rename_dict)
        for file in input[1:]:
            df2 = pd.read_csv(file, header=None, sep="\t", index_col=0)
            df2 = df2.iloc[:, [0]]
            rename_dict = {1: os.path.basename(file).replace("_ReadsPerGene.out.tab", "")}
            df2 = df2.rename(columns=rename_dict)
            df = df2.merge(df, left_index=True, right_index=True)
        os.makedirs(os.path.dirname(output[0]), exist_ok=True)
        df.to_csv(output[0], sep="\t", encoding="utf-8")
