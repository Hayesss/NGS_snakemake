import os
import pandas as pd

# 新流程配置
configfile: "config_v2.yaml"

OUT_DIR = config.get("out_dir", "v2_results")
PROJECTS = config["projects"]
FASTP_THREADS = config.get("fastp_threads", 8)
STAR_THREADS = config.get("star_threads", 8)
RESOURCES_CFG = config.get("resources", {})
LIMIT_DUMP = RESOURCES_CFG.get("limit_dump", 1)
LIMIT_MERGE = RESOURCES_CFG.get("limit_merge", 1)
BAMCOV_CFG = RESOURCES_CFG.get("bam_coverage", {})

_METADATA_CACHE = {}


def metadata_df(project):
    """Cache metadata per project."""
    if project not in _METADATA_CACHE:
        metadata_path = PROJECTS[project]["metadata"]
        _METADATA_CACHE[project] = pd.read_csv(metadata_path, sep="\t")
    return _METADATA_CACHE[project]


def experiment_ids(project):
    return metadata_df(project)["experiment_accession"].unique().tolist()


def runs_for_sample(project, sample):
    df = metadata_df(project)
    return df.loc[df["experiment_accession"] == sample, "run_accession"].tolist()


def is_paired(project, sample):
    df = metadata_df(project)
    layout = df.loc[df["experiment_accession"] == sample, "library_layout"].unique().tolist()
    return len(layout) == 1 and layout[0].upper() == "PAIRED"


def sra_path(project, sra):
    df = metadata_df(project)
    srx_id = df.loc[df["run_accession"] == sra, "experiment_accession"].tolist()[0]
    data_dir = PROJECTS[project]["data_dir"]
    return os.path.join(data_dir, f"{srx_id}/{sra}.sra")


def count_file(project, sample):
    return os.path.join(OUT_DIR, project, "02_read_align", f"{sample}_ReadsPerGene.out.tab")


def count_files_for_project(project):
    return [count_file(project, sample) for sample in experiment_ids(project)]


def bigwig_file(project, sample):
    return os.path.join(OUT_DIR, project, "04_bigwig", f"{sample}.bw")


def bigwig_files_for_project(project):
    return [bigwig_file(project, sample) for sample in experiment_ids(project)]


def merged_count_matrix(project):
    return os.path.join(OUT_DIR, project, "03_merged_counts", f"{project}.tsv")


def all_targets():
    targets = []
    for project in PROJECTS:
        targets.append(merged_count_matrix(project))
        targets.extend(count_files_for_project(project))
        targets.extend(bigwig_files_for_project(project))
    return targets


rule all:
    input:
        all_targets()


# 数据获取：SRA -> FASTQ
rule data_conversion_single:
    input:
        lambda wildcards: sra_path(wildcards.project, wildcards.sra)
    output:
        temp(f"{OUT_DIR}/{{project}}/temp/{{sra}}.fastq")
    wildcard_constraints:
        project="[A-Za-z0-9_]+",
        sra="[A-Za-z0-9]+"
    conda:
        "environment.yaml"
    resources:
        limit_dump=LIMIT_DUMP
    shell:
        "fasterq-dump {input} -O {OUT_DIR}/{wildcards.project}/temp"


rule data_conversion_pair:
    input:
        lambda wildcards: sra_path(wildcards.project, wildcards.sra)
    output:
        temp(f"{OUT_DIR}/{{project}}/temp/{{sra}}_1.fastq"),
        temp(f"{OUT_DIR}/{{project}}/temp/{{sra}}_2.fastq")
    wildcard_constraints:
        project="[A-Za-z0-9_]+",
        sra="[A-Za-z0-9]+"
    conda:
        "environment.yaml"
    resources:
        limit_dump=LIMIT_DUMP
    shell:
        "fasterq-dump {input} -O {OUT_DIR}/{wildcards.project}/temp"


# 合并同一样本的多个测序运行
def merged_single_inputs(wildcards):
    return [
        f"{OUT_DIR}/{wildcards.project}/temp/{srr}.fastq"
        for srr in runs_for_sample(wildcards.project, wildcards.sample)
    ]


def merged_r1_inputs(wildcards):
    return [
        f"{OUT_DIR}/{wildcards.project}/temp/{srr}_1.fastq"
        for srr in runs_for_sample(wildcards.project, wildcards.sample)
    ]


def merged_r2_inputs(wildcards):
    return [
        f"{OUT_DIR}/{wildcards.project}/temp/{srr}_2.fastq"
        for srr in runs_for_sample(wildcards.project, wildcards.sample)
    ]


rule merge_data:
    input:
        merged_single_inputs
    output:
        temp(f"{OUT_DIR}/{{project}}/00_raw_data/{{sample}}.fq")
